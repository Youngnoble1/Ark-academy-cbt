{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a student or administrator in the academy.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "classLevel": { "type": "string" },
        "department": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "classLevel", "createdAt"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Represents an examination module.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "classLevel": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array" },
        "theoryQuestions": { "type": "array" },
        "timeLimit": { "type": "number" },
        "isGlobal": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subject", "classLevel", "questions", "timeLimit", "createdAt"]
    },
    "Result": {
      "title": "Result",
      "description": "Student exam performance record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "quizTitle": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "maxScore": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" },
        "feedback": { "type": "string" },
        "answers": { "type": "array" }
      },
      "required": ["userId", "userName", "quizTitle", "score", "totalQuestions", "maxScore", "completedAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of students and teachers."
    },
    "quizzes": {
      "schema": "Quiz",
      "description": "Collection of CBT quizzes."
    },
    "results": {
      "schema": "Result",
      "description": "Collection of student quiz results."
    },
    "resources": {
      "schema": "Resource",
      "description": "Collection of learning resources."
    }
  }
}
