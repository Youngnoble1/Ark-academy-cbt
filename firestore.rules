rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global safety net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['student', 'teacher'] &&
             data.createdAt == request.time;
    }

    function isValidQuiz(data) {
      return data.keys().hasAll(['title', 'subject', 'classLevel', 'questions', 'creatorId', 'createdAt']) &&
             data.title is string && data.title.size() <= 200 &&
             data.subject is string &&
             data.classLevel is string &&
             data.questions is list && data.questions.size() > 0 && data.questions.size() <= 50 &&
             data.creatorId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['quizId', 'studentId', 'score', 'totalQuestions', 'completedAt']) &&
             data.quizId is string &&
             data.studentId == request.auth.uid &&
             data.score is int && data.score >= 0 && data.score <= data.totalQuestions &&
             data.completedAt == request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Prevent bulk user scraping
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      isValidUser(incoming()) && 
                      incoming().role == existing().role &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'classLevel', 'department', 'onboardingComplete']);
    }

    match /quizzes/{quizId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidQuiz(incoming());
      allow update: if false; // Quizzes are currently immutable for students/teachers
      allow delete: if false;
    }

    match /results/{resultId} {
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid);
      allow get: if isSignedIn() && resource.data.studentId == request.auth.uid;
      allow create: if isSignedIn() && isValidResult(incoming());
      allow update, delete: if false; // Results are immutable once submitted
    }

    match /resources/{resourceId} {
      allow list, get: if isSignedIn();
      allow write: if false; // System only for now
    }
  }
}
